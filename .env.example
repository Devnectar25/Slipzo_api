# Server Port
PORT=8000

# Environment Mode (production / development)
NODE_ENV=production

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_change_in_production

# Frontend Origin URL(s) - comma separated for multiple origins
FRONTEND_URL=http://localhost:5173,http://localhost:3000

# Database File Path (Optional: defaults to ./data/slipzo.db)
DATABASE_PATH=./data/slipzo.db
